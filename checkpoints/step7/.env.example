# Copy this to .env and fill in the secrets. NEVER commit your real .env.

# --- Telegram (from @BotFather) ---
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id(s), comma-separated. Get yours via /whoami. Unlocks admin cmds.
ADMIN_CHAT_IDS=

# --- Sectors API (https://sectors.app) ---
SECTORS_API_KEY=
# SECTORS_API_URL=https://api.sectors.app   # default; override only if needed

# --- LLM: Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1   # default
# MODEL_SMALL=qwen/qwen3.8-27b
# MODEL_LARGE=qwen/qwen3.8-27b
# True = full parallel report (needs a paid Groq tier). False = lean partial (free tier).
IS_PAID=false

# --- Schedule / misc ---
# TIMEZONE=Asia/Jakarta
# REPORT_TIME=07:30            # daily report time, in TIMEZONE
# DB_PATH=data/bot.db
# LOG_LEVEL=INFO
