# Copy this to .env and fill in the secrets. NEVER commit your real .env.
# On a host (Railway/Render/etc.) you set these as environment variables in the dashboard,
# not as a file.

# --- Telegram (from @BotFather) ---
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id(s), comma-separated. Get yours via /whoami. Unlocks admin cmds.
ADMIN_CHAT_IDS=

# --- Sectors API (https://sectors.app) ---
SECTORS_API_KEY=
# SECTORS_API_URL=https://api.sectors.app   # default; override only if needed
# /sector cache, in seconds (defaults shown; see app/config.py for the reasoning)
# SUBSECTOR_LIST_TTL=86400       # subsector list: 1 day
# SUBSECTOR_REPORT_TTL=21600     # one subsector report (5 credits): 6 hours
# SUBSECTOR_STALE_MAX=259200     # serve an older copy on API failure / keep buttons alive: 3 days
# /stock cache, in seconds
# STOCK_DAILY_TTL=900            # daily prices (1 credit): 15 minutes
# STOCK_REPORT_TTL=21600         # company report sections (1 credit each): 6 hours
# STOCK_STALE_MAX=259200         # older copy on API failure / buttons alive: 3 days
# /movers and /active
# RANKINGS_TTL=900               # latest rankings: 15 minutes
# RANKINGS_HISTORY_TTL=86400     # /active for a past date: 1 day
# RANKINGS_STALE_MAX=259200      # older copy on API failure: 3 days
# MOVERS_MIN_MCAP_BILLION=5000   # /movers market-cap floor, billion IDR (API default)

# --- LLM: Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1   # default
# MODEL_SMALL=qwen/qwen3.8-27b
# MODEL_LARGE=qwen/qwen3.8-27b
# True = full parallel report (needs a paid Groq tier). False = lean partial (free tier).
IS_PAID=false

# --- Schedule / misc ---
# TIMEZONE=Asia/Jakarta
# REPORT_TIME=07:30            # daily report time, in TIMEZONE
# DB_PATH=data/bot.db          # SQLite path (see DEPLOY.md about persistence)
# LOG_LEVEL=INFO
